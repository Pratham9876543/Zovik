# Zovik AI Creative Suite - Environment Configuration
PORT=5000
NODE_ENV=development

# AI LLM Provider (Google Gemini API)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Dedicated AI Music Generation Provider (e.g. Suno, ElevenLabs, or Replicate MusicGen)
AI_MUSIC_API_KEY=

# Dedicated AI Video Generation Provider (e.g. Runway, Pika, Luma, Replicate)
AI_VIDEO_API_KEY=

# Storage & Upload Directory
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
